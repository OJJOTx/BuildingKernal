# Track 2: LineageOS 23.2 (Linux 4.19.325) + Mali Valhall r32p1
# Alternative 4.19 build if vendor_a Mali EGL/Vulkan blobs are upgraded to r32p1.

CONFIG_LOCALVERSION="-perf"
# CONFIG_LOCALVERSION_AUTO is not set

# Keep Image.gz well below MediaTek LK's 16 MiB (0x01000000) zImage limit
# CONFIG_IKHEADERS is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_PANIC_ON_OOPS is not set

CONFIG_MTK_GPU_VERSION="mali valhall r32p1"

# Stock V14.0.11.0.TKLMIXM firmware & vendor_a compatibility
CONFIG_MTK_AUDIODSP_LEGACY=y
CONFIG_SDCARD_FS=y
CONFIG_MTK_CAMERA_ISP_OWE_SUPPORT=y
CONFIG_PROC_UID=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_HID_MULTITOUCH=y
# CONFIG_MTK_CONNSYS_DEDICATED_LOG_PATH is not set

# EROFS (LZ4_0PADDING / COMPACTED_2B / BIG_PCLUSTER) for HyperOS 3 gold images
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y

# ART generational concurrent copying / UFFD GC
CONFIG_USERFAULTFD=y

# Keep both Android 12 vendor_a SchedTune and Android 15 uclamp active
CONFIG_SCHED_TUNE=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# Ensure FBEv2 inlinecrypt + fs-verity + eBPF + SELinux are explicitly enabled
CONFIG_MMC_CRYPTO=y
CONFIG_FS_VERITY=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_XDP_SOCKETS=y
CONFIG_SECURITY_SELINUX=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
