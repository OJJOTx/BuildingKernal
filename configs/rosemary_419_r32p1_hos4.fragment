# Track 4 (Primary for TFFMIXM 4.19 BSP + Global HyperOS 4 Android 17):
# LineageOS 24.0 (Linux 4.19.325 + Linux 5.10 eBPF backport) + Mali Valhall r32p1
# matching Xiaomi V14.0.17.0.TFFMIXM firmware and vendor_a (r32p1-00bet0).

CONFIG_LOCALVERSION="-perf"
# CONFIG_LOCALVERSION_AUTO is not set

# Disable LTO / CFI / SCS & debug bloat so Image.gz stays < 15 MiB LK zImage cap
# and retains 100% ABI parity with TFFMIXM out-of-tree Mali r32p1 / Microtrust TEEI
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_IKHEADERS is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_PANIC_ON_OOPS is not set

CONFIG_MTK_GPU_VERSION="mali valhall r32p1"

# Official Xiaomi V14.0.17.0.TFFMIXM (4.19 BSP) firmware & vendor_a compatibility
# CONFIG_MTK_AUDIODSP_LEGACY is not set
CONFIG_MICROTRUST_DYNAMIC_CORE=y
CONFIG_SDCARD_FS=y
CONFIG_MTK_CAMERA_ISP_OWE_SUPPORT=y
CONFIG_PROC_UID=y
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_HIDRAW=y
CONFIG_HID_MULTITOUCH=y
CONFIG_USB_STORAGE=y
# CONFIG_MTK_CONNSYS_DEDICATED_LOG_PATH is not set
CONFIG_STATIC_USERMODEHELPER_PATH="/system_ext/bin/aee_core_forwarder"
CONFIG_LOG_BUF_SHIFT=21

# Pin cgroups, MediaTek EAS/perf tracker & filesystems trimmed from lineage-24.0 defconfig
CONFIG_BLK_CGROUP=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_CPUSETS=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_MTK_PERF_COMMON=y
CONFIG_MTK_PERF_TRACKER=y
CONFIG_MTK_PERF_OBSERVER=y
CONFIG_MTK_LOAD_TRACKER=y
CONFIG_MTK_CPU_CTRL_CFP=y
CONFIG_MTK_IDLE_BALANCE_ENHANCEMENT=y
CONFIG_MTK_SCHED_BIG_TASK_MIGRATE=y
CONFIG_MTK_SCHED_CPU_PREFER=y
# CONFIG_MTK_FPSGO_V3 is not set

# F2FS (userdata FBEv2 inlinecrypt) + exFAT + EROFS (OS4 system/system_ext/product/mi_ext)
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_EXFAT_FS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y

# ART + Android 17 securityfs + SchedTune & uclamp
CONFIG_USERFAULTFD=y
CONFIG_SECURITYFS=y
CONFIG_SCHED_TUNE=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# FBEv2 inlinecrypt + fs-verity + Linux 5.10 backported eBPF + SELinux
CONFIG_MMC_CRYPTO=y
CONFIG_FS_VERITY=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_BPF_EVENTS=y
CONFIG_XDP_SOCKETS=y
CONFIG_SECURITY_SELINUX=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
