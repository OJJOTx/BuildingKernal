# Track 1A: LineageOS 23.2 (Linux 4.19.325) + Mali Bifrost r25p0 (r26p0-01eac0)
# Matches untouched stock V14.0.11.0.TKLMIXM vendor_a GPU/ADSP/storage ABIs while
# providing true 4.19.325 for HyperOS 1 & Android 15 HyperOS 3 (NetBpfLoad, EROFS, UFFD).

CONFIG_LOCALVERSION="-perf"
# CONFIG_LOCALVERSION_AUTO is not set

# Keep Image.gz well below MediaTek LK's 16 MiB (0x01000000) zImage limit
# (CONFIG_IKHEADERS alone embeds ~3.42 MiB of incompressible tar.xz headers)
# CONFIG_IKHEADERS is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_DEBUG_INFO is not set
# Match stock 4.14.186 & lineage-22.2 rosemary_defconfig so non-fatal worker oopses don't hard-reboot
# CONFIG_PANIC_ON_OOPS is not set

CONFIG_MTK_GPU_VERSION="mali bifrost r25p0"

# Stock V14.0.11.0.TKLMIXM firmware & vendor_a compatibility
# 1. Legacy 240-byte ADSP IPI mailbox ABI matching stock audio_dsp_a & audio.primary.mt6785.so
CONFIG_MTK_AUDIODSP_LEGACY=y
# 2. sdcardfs required by stock vendor_a / vold for /data/media (/mnt/runtime/*/emulated)
CONFIG_SDCARD_FS=y
# 3. Camera ISP OWE (/dev/camera-owe) backported from lineage-24.0 for stock camerahalserver
CONFIG_MTK_CAMERA_ISP_OWE_SUPPORT=y
# 4. Per-UID CPU accounting (/proc/uid_*) & zRAM writeback + HID multitouch matching stock 4.14
CONFIG_PROC_UID=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_HID_MULTITOUCH=y
# 5. Prevent 1.3s R12_CONN2AP_SPM_WAKEUP_B Wi-Fi firmware log wakeups during deep sleep
# CONFIG_MTK_CONNSYS_DEDICATED_LOG_PATH is not set
# 6. Pin TEEI switch thread to CPU 6 (non-dynamic) to match untouched stock TKLMIXM tee1 (Soter_20220831)
# CONFIG_MICROTRUST_DYNAMIC_CORE is not set

# EROFS (LZ4_0PADDING / COMPACTED_2B / BIG_PCLUSTER) for HyperOS 3 gold images
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y

# ART generational concurrent copying / UFFD GC (ro.dalvik.vm.enable_uffd_gc=true)
CONFIG_USERFAULTFD=y

# Keep both Android 12 vendor_a SchedTune (/dev/stune) and Android 15 uclamp active
CONFIG_SCHED_TUNE=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# Ensure FBEv2 inlinecrypt + fs-verity + eBPF + SELinux are explicitly enabled
CONFIG_MMC_CRYPTO=y
CONFIG_FS_VERITY=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_XDP_SOCKETS=y
CONFIG_SECURITY_SELINUX=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
